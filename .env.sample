# Local-only credentials for ad-hoc Jenkins + GitLab scripts run from this repo.
# Copy to `.env` (gitignored) and fill in your own values; never commit `.env`.
#
# JENKINS_TOKEN — Jenkins API token (https://maya-jenkins/user/<you>/configure)
# JENKINS_USER — Jenkins username (usually same as GitLab user)
# GITLAB_TOKEN — GitLab PAT with `api` + `read_repository` scopes on gitlab.ulakhaberlesme.com.tr
# GITLAB_USER — GitLab username

JENKINS_TOKEN=
JENKINS_USER=
GITLAB_TOKEN=
GITLAB_USER=
